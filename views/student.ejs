<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=student.name%></title>
    <link rel="stylesheet" href="../css/card.css">
</head>
<body>
    
<div class="business-card">
        <h1><%=student.name%></h1>
        <p><strong>Form:&emsp;</strong><%=student.form%></p>
        <p>Area of Residence: &emsp;<%=student.address%></p>
        <p>Student Status: &emsp;<%=student.status%></p>
        <p>Phone:&emsp;<%=student.phoneNumber%></p>
        <hr>
        <a href="/home"><button class="btn-secondary">Go to Home</button></a>
</div>

</body>
</html>