<%- include('./base/header.ejs') %>


<% if (records.length < 1) { %>


<div class="container mt-5">
<div class="row justify-content-center">
<div class="col-md-6">
<div class="card shadow-sm">
<div class="card-header text-center bg-secondary text-white">
<h4>Add New Student</h4>
</div>
<div class="card-body">
<form method="POST" action="/new_record">
<!-- Name -->
<div class="mb-3">
<label for="name" class="form-label">Student Name</label>
<input type="text" class="form-control" id="name" name="name"  required>
</div>

<!-- Form -->
<div class="mb-3">
<label for="form" class="form-label">Form</label>
<input type="text" class="form-control" id="form" name="form" required>
</div>

<!-- address -->
<div class="mb-3">
<label for="address" class="form-label">Address</label>
<input type="text" class="form-control" id="address" name="address"  required>
</div>

<!-- Phone number -->
<div class="mb-3">
<label for="phoneNumber" class="form-label">Phone Number</label>
<input type="number" class="form-control" id="phone-number" name="phoneNumber"  required>
</div>

<!-- status-->
<div class="mb-3">
<label for="phoneNumber" class="form-label">Status</label>
<select name="status"  class="form-select" aria-label="Default select example">
 <option value="Selected at form 1">Selected at form 1</option>
 <option value="Transfer">Transfer</option>
 <option value="Not selected">Not selected</option>
</select>

</div>

<!-- Submit Button -->
<button class="btn btn-secondary w-100">Add Student</button>
</form>
</div>
</div>
</div>
</div>
</div>



<%- include('./base/footer.ejs') %>3
<% } else { %>

<div class="container my-5">
<table class="table">
  <thead>
    <tr>
      <th scope="col">No:</th>
      <th scope="col">Student Name</th>
      <th scope="col">Form</th>
      <th scope="col">Phone Number</th>
      <th scope="col">Location</th>
       <th scope="col">Status</th>
      <th scope="col">Edit</th>
      <th scope="col">Delete</th>
    </tr>
  </thead>
  <tbody>
    <% for( let i = 0; i < records.length; i++ ) { %>
    <tr>
      <th scope="row"><%=i+1%>.</th>
      <td><%= records[i].name %></td>
      <td><%= records[i].form %></td>
      <td><%= records[i].phoneNumber %></td>
      <td><%= records[i].address %></td>
      <td><%= records[i].status %></td>
      <td><a href="/edit/<%= records[i]._id %>">Edit</a></td>
      <td>

        <form action="/delete/<%= records[i]._id %>" method="POST">
          <input type="submit" value="Delete" class="btn btn-danger btn-small">
        </form>
      </td>
    </tr>
     <% } %>
  
  </tbody>
</table>

<!-------Pagination-->
<div class="container-fluid">
<div class="pagination">
  <% if (currentPage >1) { %>
   <a href="/home?page=<%= currentPage-1 %>" class="page-link">Previous</a>
  <% } %>

  <% for( let i = 1; i <= totalPages; i++ ) { %>
  <% if (i=== currentPage) { %>
   <strong class="page-link active"><%=i %></strong>
  <% } else{ %>
    <a href="/home?page=<%= i %>" class="page-link"><%= i %></a>
  <% } %>
   <% } %>
   <% if (currentPage <totalPages) { %>
    <a href="/home?pages=<%= currentPage +1 %>" class="page-link">Next</a>
   <% } %>


</div>
</div>


<% } %>





<%- include('./base/footer.ejs') %>